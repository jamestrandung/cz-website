---
// Like Localized.astro, but the Vietnamese side may contain a "[cà]" marker
// (see stripCaMark/renderCaMark in domain/presentation) that renders as the
// CaMark logo glyph instead of plain text. English never carries the marker.
// The language-toggle script (menu.ts, applyLocale) special-cases
// [data-vi-mark] separately from the generic [data-vi][data-en] swap, since
// that swap is textContent-only and would strip the mark back to plain text.
import { escapeHtml, renderCaMark, stripCaMark } from '../domain/presentation';
import { caMarkSvg } from './caMark';
import type { Localized as LocalizedValue } from '../domain/menu';
interface Props {
  value: LocalizedValue;
  class?: string;
  markSize?: number;
}
const { value, class: className, markSize = 20 } = Astro.props;
const viHtml = renderCaMark(value.vi, escapeHtml, caMarkSvg({ size: markSize }));
---

<span class={className} data-vi-mark={viHtml} data-en={stripCaMark(value.en)} set:html={viHtml} />
