{
  "name": "ca-zone-menu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/menu.test.ts tests/combos.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests astro.config.mjs playwright.config.ts",
    "format:check": "prettier --check src tests astro.config.mjs playwright.config.ts",
    "photos:prepare": "node scripts/prepare-photos.mjs",
    "photos:optimize": "node scripts/optimize-image.mjs",
    "menu:check": "node --import tsx scripts/check-menu.ts",
    "test:images": "node --test tests/images.test.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "astro": "7.3.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "sharp": "0.35.4"
  }
}
